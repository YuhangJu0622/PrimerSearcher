# Copy private values into the single .secrets/tool_api_keys.env file.
# The private file must have mode 600.

SERPER_API_KEYS=key1,key2
JINA_API_KEYS=key1,key2

# Shared by visit summarization and the answer judge. DMX is OpenAI-compatible.
DMX_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=replace-me
DMX_MODEL=qwen-plus

# Optional judge-specific overrides; normally unnecessary.
# JUDGE_BASE_URL=...
# JUDGE_API_KEY=...
# JUDGE_MODEL=...
OPENSEEKER_JUDGE_ENABLED=1
JUDGE_CONFIDENCE_THRESHOLD=0.90
JUDGE_MAX_RETRIES=2
